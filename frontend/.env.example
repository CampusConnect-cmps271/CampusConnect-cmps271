# Copy this file to .env.local and fill it in. .env.local is never committed.
#
# Local development: run `npx supabase start` and copy the values it prints
# (or re-read them any time with `npx supabase status`).
# Hosted project: take the URL and publishable key from the Supabase
# dashboard under Project Settings -> API Keys.

# ---- Public: these are inlined into the browser bundle ----
# Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# "PUBLISHABLE_KEY" from `supabase status` (sb_publishable_...).
# A legacy "ANON_KEY" JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the app is served. Used for auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of university email domains allowed to sign in.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=mail.aub.edu

# ---- Server-only: never prefix these with NEXT_PUBLIC_ ----
# "SECRET_KEY" from `supabase status` (sb_secret_...), or a legacy
# "SERVICE_ROLE_KEY" JWT. Bypasses row-level security; keep it off the client.
SUPABASE_SECRET_KEY=

# ---- Optional elective AI gateway: server-only, leave both blank to disable ----
# HTTPS gateway implementing the operations and schemas in modules/electives/README.md.
# A vendor's raw model API requires a compatible adapter; it is not this contract.
ELECTIVES_PROVIDER_URL=
ELECTIVES_PROVIDER_TOKEN=

# ---- Test account created by `npm run seed:test-user` ----
# The email domain must be in NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS, and the
# password must meet supabase/config.toml: 8+ characters with a lowercase
# letter, an uppercase letter, a digit and a symbol.
TEST_USER_EMAIL=test.student@mail.aub.edu
TEST_USER_PASSWORD=

# ---- Demo accounts created by `npm run seed:demo` (SCRUM-182) ----
# A student, a moderator and an administrator for the sprint review. Use three
# different addresses at an allowed domain; plus-addresses of your own AUB
# email work, e.g. you+demo-student@mail.aub.edu. Same password rules as above.
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_MODERATOR_EMAIL=
DEMO_MODERATOR_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# ---- Hosted project: put these in .env.hosted.local, never in .env.local ----
# Read only by `npm run seed:demo -- --hosted` and `npm run test:smoke`.
# .env.hosted.local is never committed; repeat the DEMO_* lines there too.
# HOSTED_SUPABASE_URL=https://<project-ref>.supabase.co
# HOSTED_SUPABASE_SECRET_KEY=
# SMOKE_BASE_URL=https://<your-app>.vercel.app

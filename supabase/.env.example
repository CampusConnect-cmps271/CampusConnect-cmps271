# Copy to supabase/.env. Read by the Supabase CLI to fill the env(...) values
# in config.toml. Not read by the Next.js app -- that uses .env.local.
#
# These live here, rather than as literals in config.toml, because the same
# file configures both local and the hosted project. `supabase config push`
# would otherwise set the hosted Site URL to localhost.

# Local development: the dev server's origin.
# Hosted: the deployed app's origin, set before running `supabase config push`.
SUPABASE_AUTH_SITE_URL=http://localhost:3000

# Comma-separated list of exact URLs auth is allowed to redirect to.
# Sign-up verification needs none of these: it uses an 8-digit code, not a link.
# These cover OAuth callbacks and password reset.
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3000/auth/callback,http://localhost:3000/auth/reset-password

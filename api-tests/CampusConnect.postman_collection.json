    {
      "name": "POST /api/auth/reset-password",
      "item": [
        {
          "name": "Valid requests",
          "item": [
            {
              "name": "RP-01 correct code and strong password resets the password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/auth/reset-password",

      "name": "POST /api/auth/forgot-password",
      "item": [
        {
          "name": "Valid requests",
          "item": [
            {
              "name": "FP-01 registered email sends a code",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/auth/forgot-password",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "forgot-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('generic message (does not reveal if email exists)', () => pm.expect(pm.response.json().message).to.eql('If an account exists for that email, a password reset code has been sent.'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "FP-02 unregistered email returns the same response",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
